# --------------------------------------------------------------------------------------
# Commodity
# --------------------------------------------------------------------------------------
commodity €
    note Евро
    format €1000.000
    nomarket
    alias EUR

; FIXME: to map to the standard account codes

; НД: Нестопанска Дейност
; СД: Стопанска Дейност

# --------------------------------------------------------------------------------------
# Приходи
# --------------------------------------------------------------------------------------
account Приходи:НД:Дарения:Ограничени
    note 713 Приходи от дарения

account Приходи:НД:Дарения:Ограничени
account Приходи:НД:Дарения:Неограничени

account Приходи:НД:Дарения в натура:Ограничени
account Приходи:НД:Дарения в натура:Неограничени

account Приходи:НД:Членски внос
    note 712 Приходи от членски внос

# --------------------------------------------------------------------------------------
# Активи
# --------------------------------------------------------------------------------------
account Активи:Банка
account Активи:Кеш
account Активи:Материални:Значки
account Активи:Нематериални:Интернет домейн

# --------------------------------------------------------------------------------------
# Разходи
# --------------------------------------------------------------------------------------
account Разходи:НД:Материални:Реклама:Значки
account Разходи:НД:Материални:Реклама:Флаери
account Разходи:НД:Нематериални:Интернет домейн
account Разходи:НД:Нематериални:Реклама:Фейсбук
account Разходи:НД:Административни:Наеми
account Разходи:НД:Банка:Такси

# --------------------------------------------------------------------------------------
# Payee
# --------------------------------------------------------------------------------------
payee Онлайн услуги
payee Рекламни материали
payee Членски внос
payee Общо събрание
payee Реклама на събитие
payee Банка такса обслужване

# --------------------------------------------------------------------------------------
# Tags
# --------------------------------------------------------------------------------------
tag UUID
tag FIXME

tag Фактура
tag Пояснение
tag Дарител
tag Количество
tag Изтича
    assert value =~ /^\\d{4}\/(0[1-9]|1[0-2])\/(0[1-9]|[12]\\d|3[01])$/

tag Програма
tag Събитие

tag Payee

include tags/generated/tag_member.ledger
